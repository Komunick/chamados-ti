# Chamados de TI — valores deste sistema para o devops/ctl.sh.
# Tudo aqui pode ser sobrescrito por variável de ambiente na hora de rodar.

# Nome curto do serviço (usado no log, no pgrep e na marca do cron).
SERVICO="chamados-ti"
NOME_LONGO="Chamados de TI"

# Pasta do app dentro do repositório (onde fica server/server.js).
APP_SUBDIR="ti-web"

# Porta padrão e pasta de dados.
PORTA_PADRAO="8085"
DATA_SUBDIR="ti-data"

# Nome da variável de ambiente que o servidor lê para achar os dados.
DATA_ENV="TI_DATA_DIR"

# Variáveis extras da aplicação, repassadas ao processo toda vez que ele sobe
# (inclusive quando o cron o ressobe). É AQUI que elas têm de morar: exportar
# na sessão só vale até o serviço cair.
EXTRA_ENV=(
  # PAT_LINK_ASSINATURA=https://assinatura.exemplo.com
)

# Binário do Node. Vazio = descobre sozinho (nvm v22 → maior versão → PATH).
# Fixe aqui se a VM tiver várias versões e você quiser garantir uma.
NODE_BIN="${NODE_BIN:-}"
